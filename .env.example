# Required for live company research and analysis. Configure it as a server-side
# environment variable in Vercel; never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Required on Vercel. Share this code only with people allowed to use the paid
# analysis endpoint; the browser sends it per request and does not persist it.
ANALYZE_ACCESS_TOKEN=
